# ==============================================================================
# ScamGuard — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the root (for Docker Compose) or set the appropriate
# variables in your respective backend / frontend environments for local execution.
# ==============================================================================

# --- Application Security ---
# Secret key used for signing JWT access and refresh tokens.
# Generate a new random key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-secure-secret-key-of-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database Configuration ---
# Leave empty or omit to automatically use local SQLite (`sqlite:///./scam_guard.db`).
# For PostgreSQL (Docker / Production), provide the connection string:
# DATABASE_URL=postgresql://scam_user:scam_password@localhost:5432/scam_detection
DATABASE_URL=
POSTGRES_USER=scam_user
POSTGRES_PASSWORD=scam_password
POSTGRES_DB=scam_detection

# --- Microservice Networking & CORS ---
# In development, the Next.js server rewrites /backend-api/* to APP_SERVICE_URL.
APP_SERVICE_URL=http://localhost:8000
ML_SERVICE_URL=http://localhost:8002
CORS_ORIGINS=http://localhost:3000,https://frontend-psi-ebon-83.vercel.app

# --- Machine Learning Engine ---
# Model identifier loaded by ml_service from backend/artifacts/
PRODUCTION_MODEL_NAME=naive_bayes
ARTIFACTS_DIR=artifacts
