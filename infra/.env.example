# Copy to infra/.env before running `docker compose up`.

POSTGRES_USER=scam_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=scam_detection

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret-of-at-least-32-characters

CORS_ORIGINS=http://localhost:3000

PRODUCTION_MODEL_NAME=naive_bayes
