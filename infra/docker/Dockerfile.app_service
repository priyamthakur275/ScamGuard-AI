# syntax=docker/dockerfile:1
# Build context: repository root (paths below start with backend/)
# Build with:  docker build -f infra/docker/Dockerfile.app_service -t scamguard-app-service .

FROM python:3.12-slim AS builder

WORKDIR /build
RUN set -eux; \
        apt-get update; \
        for i in 1 2 3 4 5; do \
            apt-get install -y --no-install-recommends build-essential libpq-dev && break || (apt-get update && sleep 2); \
        done; \
        rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# --------------------------------------------------------------------------

FROM python:3.12-slim AS runtime

RUN set -eux; \
        apt-get update; \
        for i in 1 2 3 4 5; do \
            apt-get install -y --no-install-recommends libpq5 curl tesseract-ocr libzbar0 && break || (apt-get update && sleep 2); \
        done; \
        rm -rf /var/lib/apt/lists/*; \
        useradd --create-home --uid 1000 appuser

WORKDIR /app

COPY --from=builder /root/.local /home/appuser/.local
COPY backend/app_service ./app_service
COPY backend/ml_common ./ml_common
COPY backend/ml_service ./ml_service
COPY backend/artifacts ./artifacts
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY infra/docker/start_app_service.sh ./start_app_service.sh

RUN chown -R appuser:appuser /app
USER appuser

ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/api/v1/health || exit 1

# Run migrations, then start the API server (see start_app_service.sh: if the
# configured database is unreachable it falls back to a temporary SQLite file
# instead of crash-looping). Defaults to ONE uvicorn worker: each worker loads
# its own copy of the model, scikit-learn/numpy and OCR stack (~250 MB RSS), so
# more than one exceeds the 512 MB of Render's free instance.
CMD ["sh", "./start_app_service.sh"]
