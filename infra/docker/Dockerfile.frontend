# syntax=docker/dockerfile:1
# Build context: frontend/
# Build with:  docker build -f infra/docker/Dockerfile.frontend -t scamguard-frontend frontend
#
# Next.js rewrites are compiled at build time; supply the backend URL as a build argument.

FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

# --------------------------------------------------------------------------

FROM node:20-slim AS builder
WORKDIR /app

ARG APP_SERVICE_URL=http://app_service:8000
ENV APP_SERVICE_URL=$APP_SERVICE_URL
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# --------------------------------------------------------------------------

FROM node:20-slim AS runtime
WORKDIR /app

RUN addgroup --system appuser && adduser --system --ingroup appuser appuser

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

# next.config.js no longer uses `output: "standalone"` (Render runs the
# standard Next server), so the image runs `next start` the same way.
COPY --chown=appuser:appuser package.json package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=builder --chown=appuser:appuser /app/next.config.js ./next.config.js
COPY --from=builder --chown=appuser:appuser /app/public ./public
COPY --from=builder --chown=appuser:appuser /app/.next ./.next

USER appuser
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://localhost:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npx", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
