{
  "manifest_version": 3,
  "name": "ScamGuard — Scam Checker",
  "version": "1.0.0",
  "description": "Right-click any message or link to check it for scams with ScamGuard. Built for Indian scams: KYC, OTP, UPI, job and digital-arrest frauds.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Check a message with ScamGuard" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["https://scamguard-frontend-r6t7.onrender.com/*"]
}
