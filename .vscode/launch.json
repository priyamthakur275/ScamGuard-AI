{
  // Run and Debug panel: breakpoints in the backend or frontend.
  // Run "ScamGuard: Install / repair setup" once first.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app_service.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe" },
      "env": { "PYTHONUNBUFFERED": "1" },
      "justMyCode": true
    },
    {
      "name": "Frontend: Next.js dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "env": { "APP_SERVICE_URL": "http://127.0.0.1:8000" }
    }
  ],
  "compounds": [
    {
      "name": "ScamGuard: Debug both",
      "configurations": ["Backend: FastAPI (debug)", "Frontend: Next.js dev"],
      "stopAll": true
    }
  ]
}
