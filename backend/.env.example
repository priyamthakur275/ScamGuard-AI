# ---- App ----
APP_NAME=Scam Detection Application Service
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Security / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
DATABASE_URL=postgresql+psycopg2://scam_user:scam_pass@localhost:5432/scam_detection

# ---- Internal ML service (server-to-server) ----
ML_SERVICE_URL=http://localhost:8002

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# ---- Voice transcription (optional; unset = server-side audio-file
# transcription reports "unavailable" honestly, browser live transcription
# still works regardless) ----
VOICE_TRANSCRIPTION_PROVIDER=
VOICE_TRANSCRIPTION_API_KEY=

# ---- Copilot LLM (optional; unset = deterministic evidence-grounded
# answers only, no external LLM) ----
COPILOT_LLM_PROVIDER=
COPILOT_LLM_API_KEY=

# ---- Logging ----
LOG_LEVEL=INFO
