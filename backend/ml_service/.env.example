# ---- App ----
APP_NAME=Scam Detection ML Inference Service
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# ---- Model artifacts ----
# Directory containing the model registry produced by
# `python -m ml_training.run_training`. This default matches the local
# development walkthrough in the root README (run from backend/, so this
# resolves to backend/artifacts). Docker/Railway deployments override
# this to an absolute path (e.g. /app/artifacts) via their own
# environment configuration -- see infra/docker-compose.yml.
ARTIFACTS_DIR=artifacts
PRODUCTION_MODEL_NAME=naive_bayes

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_PREDICT=60/minute

# ---- Logging ----
LOG_LEVEL=INFO
